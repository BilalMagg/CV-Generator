# group_vars/secrets.yml.example — copy to secrets.yml and fill in real values.
#
# secrets.yml is GITIGNORED. These values are pushed to SSM /cvgen/secrets/*
# by the secrets_overlay role. db_password MUST equal the Terraform db_password.
#
# Encrypt the real file with: ansible-vault encrypt group_vars/secrets.yml
# and run the playbook with --ask-vault-pass.

# RDS master password (must match terraform.tfvars db_password)
db_password: "CHANGE-ME-strong-password"

# LLM providers — groq is required; the rest are optional fallbacks (leave "" if unused)
groq_api_key: "CHANGE-ME"
openai_api_key: ""
mistral_api_key: ""

# search-agent optional web-search providers (leave "" if unused)
tavily_api_key: ""
crawl4ai_api_key: ""

# Keycloak
keycloak_client_secret: "CHANGE-ME"     # cv-gateway client secret (also set in the realm)
keycloak_admin_password: "CHANGE-ME"

# Social IdPs (also used by notification-service for Gmail). Leave "" to skip.
google_client_id: ""
google_client_secret: ""
github_client_id: ""
github_client_secret: ""

# notification-service Gmail token encryption (AES-256 key, base64) + SMTP
gmail_token_encryption_key: "CHANGE-ME-base64-aes-256-key"
smtp_username: ""
smtp_password: ""

# MinIO credentials (template-agent reads these)
minio_root_user: "minioadmin"
minio_root_password: "CHANGE-ME"
