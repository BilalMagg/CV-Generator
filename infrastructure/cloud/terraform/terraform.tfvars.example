# terraform.tfvars.example — copy to terraform.tfvars and fill in.
# terraform.tfvars is gitignored (it carries the DB password). You can also
# pass db_password via the environment instead: export TF_VAR_db_password=...

region  = "us-east-1"
project = "cvgen"

# RDS master credential — reused for all 8 logical databases.
db_username = "postgres"
db_password = "CHANGE-ME-strong-password"   # do NOT commit the real value

# Sizing (demo defaults shown; uncomment to override)
# db_instance_class = "db.t3.small"
# ecs_instance_type = "t3.large"
# ecs_desired_size  = 3

# image_tag = "latest"
