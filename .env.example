# ── Network topology ──────────────────────────────────────────────────────────
CV_NETWORK=cv-network

# ── Keycloak ──────────────────────────────────────────────────────────────────
KEYCLOAK_HOST=keycloak
KEYCLOAK_PORT=8080
KEYCLOAK_EXTERNAL_HOST=localhost
KEYCLOAK_EXTERNAL_PORT=9090
KEYCLOAK_CLIENT_ID=cv-client
KEYCLOAK_AUTHORITY=http://keycloak:8080/realms/cv-realm
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_RESPONSE=code
KEYCLOAK_CALLBACK_PATH=/signin-oidc
KEYCLOAK_REQUIRE_HTTPS=false
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_ADMIN_CLIENT_ID=admin-cli
KEYCLOAK_ADMIN_URL=http://keycloak:8080

# ── API Gateway ──────────────────────────────────────────────────────────────
GATEWAY_HOST=cv-api-gateway
GATEWAY_PORT=8080

# ── Frontend ──────────────────────────────────────────────────────────────────
FRONTEND_HOST=localhost
FRONTEND_PORT=4200

# ── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_HOST=kafka
KAFKA_PORT=9092

# ── User Service ──────────────────────────────────────────────────────────────
USER_SERVICE_HOST=cv-user-service
USER_SERVICE_PORT=8082
USER_SERVICE_GRPC_PORT=18082

# ── User Content Service ──────────────────────────────────────────────────────
CONTENT_SERVICE_HOST=cv-user-content-service
CONTENT_SERVICE_PORT=8083
CONTENT_SERVICE_GRPC_PORT=18083

# ── Workflow Service ──────────────────────────────────────────────────────────
WORKFLOW_SERVICE_HOST=cv-workflow-service
WORKFLOW_SERVICE_PORT=8084
WORKFLOW_SERVICE_GRPC_PORT=18084

# ── Application Service ───────────────────────────────────────────────────────
APPLICATION_SERVICE_HOST=cv-application-service
APPLICATION_SERVICE_PORT=8085
APPLICATION_SERVICE_GRPC_PORT=18085

# ── Job Offer Service ─────────────────────────────────────────────────────────
JOB_OFFER_SERVICE_HOST=cv-job-offer-service
JOB_OFFER_SERVICE_PORT=8086

# ── Notification Service ──────────────────────────────────────────────────────
NOTIFICATION_SERVICE_HOST=cv-notification-service
NOTIFICATION_SERVICE_PORT=8087

# ── CV Service ────────────────────────────────────────────────────────────────
CV_SERVICE_HOST=cv-cv-service
CV_SERVICE_PORT=8088
CV_SERVICE_GRPC_PORT=18088

# ── AI Agent — Job Extractor ──────────────────────────────────────────────────
JOB_EXTRACTOR_HOST=cv-job-extractor
JOB_EXTRACTOR_PORT=8001

# ── AI Agent — Search Agent ───────────────────────────────────────────────────
SEARCH_AGENT_HOST=cv-search-agent
SEARCH_AGENT_PORT=8002

# ── AI Agent — Template Agent ─────────────────────────────────────────────────
TEMPLATE_AGENT_HOST=cv-template-agent
TEMPLATE_AGENT_PORT=8003

# ── AI Agent — CV Optimizer ───────────────────────────────────────────────────
CV_OPTIMIZER_HOST=cv-optimizer
CV_OPTIMIZER_PORT=8004

# ── AI Agent — Contact Agent ──────────────────────────────────────────────────
CONTACT_AGENT_HOST=cv-contact-agent
CONTACT_AGENT_PORT=8005

# ── AI Agent — Job Crawler ────────────────────────────────────────────────────
JOB_CRAWLER_HOST=cv-job-crawler
JOB_CRAWLER_PORT=8006

# ── Orchestrator ──────────────────────────────────────────────────────────────
ORCHESTRATOR_HOST=cv-orchestrator
ORCHESTRATOR_PORT=8000

# ── Databases ─────────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
USER_DB_HOST=user-db
USER_DB_PORT=5432
CONTENT_DB_HOST=content-db
CONTENT_DB_PORT=5432
WORKFLOW_DB_HOST=workflow-db
WORKFLOW_DB_PORT=5432
APPLICATION_DB_HOST=application-db
APPLICATION_DB_PORT=5432
JOB_OFFER_DB_HOST=job-offer-db
JOB_OFFER_DB_PORT=5432
NOTIFICATION_DB_HOST=notification-db
NOTIFICATION_DB_PORT=5432
CV_DB_HOST=cv-db
CV_DB_PORT=5432

# ── PostgreSQL credentials (shared across all DBs) ───────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ── SMTP (notification-service) ──────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_HOST=cv-minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ── OAuth (set callback URL to http://localhost:9090/realms/cv-realm/broker/<provider>/endpoint) ──
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# ── Gmail OAuth token encryption (AES-256 key, base64-encoded) ──────────────
GMAIL_TOKEN_ENCRYPTION_KEY=change-me

# ── SonarCloud ────────────────────────────────────────────────────────────────
SONAR_HOST_URL=https://sonarcloud.io
SONAR_ORG=Nour1902
SONAR_TOKEN=change-me
