# =============================================================================
# Propel deployment configuration (copy to `.env` next to the compose file)
# docker compose reads this file automatically when run from the deploy/ dir,
# or pass it explicitly:  docker compose --env-file deploy/.env -f deploy/docker-compose.yml up
# =============================================================================

# ── Gmail (optional, but needed to send applications by email) ───────────────
# Create an OAuth client at https://console.cloud.google.com (type: Web
# application) and add the redirect:
#     http://localhost:4200/api/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Base64-encoded 32-byte key used to encrypt Gmail tokens in the database.
# Generate once and back it up — changing it makes existing tokens unreadable.
#   openssl rand -base64 32
# (PowerShell:  [Convert]::ToBase64String((1..32 | %{[byte](Get-Random -Max 256))}) )
GMAIL_TOKEN_ENCRYPTION_KEY=
