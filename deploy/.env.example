# =============================================================================
# Propel deployment configuration (copy to `.env` next to the compose file)
# docker compose reads this file automatically when run from the deploy/ dir,
# or pass it explicitly: docker compose --env-file deploy/.env -f deploy/docker-compose.yml up
# =============================================================================

# ── Deployment Profile ───────────────────────────────────────────────────────
# Choose which local container services to spin up alongside PostgreSQL and App:
#   minio    → Local MinIO container (local object storage + native auth) [DEFAULT]
#   minimal  → PostgreSQL only (use with Cloudflare R2 + native auth)
#   keycloak → Keycloak containers (Keycloak auth + cloud storage)
#   full     → Full self-hosted stack (PostgreSQL + MinIO + Keycloak)
COMPOSE_PROFILES=minio

# ── Provider Selection ───────────────────────────────────────────────────────
# Storage provider: "MinIO" or "CloudflareR2"
STORAGE_PROVIDER=MinIO

# Authentication provider: "Native" (default, lightweight), "Keycloak", or "Hybrid"
AUTH_PROVIDER=Native

# Email provider: "Gmail"
EMAIL_PROVIDER=Gmail

# ── Object Storage: MinIO (Used when STORAGE_PROVIDER=MinIO) ─────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ── Object Storage: Cloudflare R2 (Used when STORAGE_PROVIDER=CloudflareR2) ──
# Get these from your Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=propel
# Optional public base URL (e.g. https://pub-xxxxxx.r2.dev or custom domain)
R2_PUBLIC_BASE_URL=

# ── Gmail Integration (Per-user direct OAuth, decoupled from Keycloak) ───────
# Create an OAuth client at https://console.cloud.google.com (type: Web application)
# Authorized redirect URI: http://localhost:4200/api/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Base64-encoded 32-byte key used to encrypt Gmail refresh tokens in the database.
# Generate once and back it up:
#   Linux/macOS: openssl rand -base64 32
#   PowerShell:  [Convert]::ToBase64String((1..32 | %{[byte](Get-Random -Max 256)}))
GMAIL_TOKEN_ENCRYPTION_KEY=
GMAIL_CALLBACK_BASE_URL=http://localhost:4200

# ── Keycloak (Only needed when AUTH_PROVIDER=Keycloak or Hybrid) ─────────────
KEYCLOAK_HOST=keycloak
KEYCLOAK_PORT=8080
KEYCLOAK_EXTERNAL_HOST=localhost
KEYCLOAK_EXTERNAL_PORT=9090
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin
JWT_AUTHORITY=http://keycloak:8080/realms/cv-realm
