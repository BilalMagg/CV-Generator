# LLM Providers
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=

# Per-provider default chat models (final fallback; live catalog is authoritative)
OMNIROUTE_MODEL=auto/best-coding
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_MODEL=gpt-4o
GOOGLE_MODEL=gemini-2.0-flash
MISTRAL_MODEL=mistral-large-latest

# Embeddings (local by default — no API key required)
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Backend
BACKEND_BASE_URL=http://localhost:5000

# SMTP (contact-agent)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# MinIO (template-agent)
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_SECURE=false

# Kafka (crawler, extractor) — optional
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# CV Optimizer chat history
DATABASE_URL=postgresql://postgres:bime@localhost:5432/cv_monolith
