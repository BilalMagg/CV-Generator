# ── workflow-service environment variables ────────────────────────────────────
# Copy to .env and fill in secrets before running locally.
# Docker deployments override these via compose environment: blocks.

# ── Server ports ──────────────────────────────────────────────────────────────
PORT=5003
GRPC_PORT=18084

# ── Database ──────────────────────────────────────────────────────────────────
ConnectionStrings__DefaultConnection=Host=localhost;Port=5435;Database=workflow_db;Username=postgres;Password=postgres

# ── Kafka ──────────────────────────────────────────────────────────────────────
# Local dev: use EXTERNAL listener (29092). Docker: kafka:9092
KAFKA_BOOTSTRAP_SERVERS=localhost:29092

# ── AI Agent URLs ─────────────────────────────────────────────────────────────
# Local dev: agents run in Docker, accessible via localhost ports.
# Docker: use service names (cv-job-extractor:8001, etc.)
JOB_EXTRACTOR_URL=http://localhost:8001/api/v1/
SEARCH_AGENT_URL=http://localhost:8002/api/v1/
TEMPLATE_AGENT_URL=http://localhost:8003/api/v1/
CV_OPTIMIZER_URL=http://localhost:8004/api/v1/
CONTACT_AGENT_URL=http://localhost:8005/api/v1/
