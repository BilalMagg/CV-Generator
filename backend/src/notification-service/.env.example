# ── notification-service environment variables ────────────────────────────────
# This file is loaded at startup by DotNetEnv.Env.Load() in Program.cs.
# Copy to .env and fill in real values before running.
# Docker deployments override these via compose environment: blocks.

# ── Server port ───────────────────────────────────────────────────────────────
PORT=5006

# ── Database ──────────────────────────────────────────────────────────────────
# Local dev: notification-db container is mapped to localhost:5438
# Docker: Host=notification-db;Port=5432
ConnectionStrings__DefaultConnection=Host=localhost;Port=5438;Database=notification_db;Username=postgres;Password=postgres

# ── Kafka ──────────────────────────────────────────────────────────────────────
# Local dev: use EXTERNAL listener (29092). Docker: kafka:9092
Kafka__BootstrapServers=localhost:29092

# ── gRPC clients ──────────────────────────────────────────────────────────────
# Local dev: point to local gRPC ports. Docker: use service names.
USER_SERVICE_GRPC_URL=http://localhost:18082
APPLICATION_SERVICE_GRPC_URL=http://localhost:18085

# ── Gmail OAuth callback ───────────────────────────────────────────────────────
Gmail__CallbackBaseUrl=http://localhost:8080

# ── SMTP (for email sending) ──────────────────────────────────────────────────
Smtp__Host=smtp.gmail.com
Smtp__Port=587
Smtp__Username=
Smtp__Password=
Smtp__FromEmail=

# ── Google OAuth (for Gmail integration) ─────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Gmail token encryption key (AES-256, base64-encoded) ─────────────────────
GMAIL_TOKEN_ENCRYPTION_KEY=
