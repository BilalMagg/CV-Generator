# ── user-service environment variables ────────────────────────────────────────
# Copy to .env and fill in secrets before running locally.
# Docker deployments override these via compose environment: blocks.

# ── Server ports ──────────────────────────────────────────────────────────────
PORT=5001
GRPC_PORT=18082

# ── Database ──────────────────────────────────────────────────────────────────
ConnectionStrings__DefaultConnection=Host=localhost;Port=5433;Database=user_db;Username=postgres;Password=postgres

# ── Kafka ──────────────────────────────────────────────────────────────────────
# Local dev: use EXTERNAL listener (29092). Docker: kafka:9092
KAFKA_BOOTSTRAP_SERVERS=localhost:29092

# ── Keycloak / JWT ────────────────────────────────────────────────────────────
# Local dev: Keycloak runs in Docker on port 9090
Jwt__Authority=http://localhost:9090/realms/cv-realm
