# ── application-service environment variables ─────────────────────────────────
# Copy to .env and fill in secrets before running locally.
# Docker deployments override these via compose environment: blocks.

# ── Server ports ──────────────────────────────────────────────────────────────
PORT=5004
GRPC_PORT=18085

# ── Database ──────────────────────────────────────────────────────────────────
ConnectionStrings__DefaultConnection=Host=localhost;Port=5436;Database=application_db;Username=postgres;Password=postgres

# ── Kafka ──────────────────────────────────────────────────────────────────────
# Local dev: use EXTERNAL listener (29092). Docker: kafka:9092
KAFKA_BOOTSTRAP_SERVERS=localhost:29092

# ── Keycloak / JWT ────────────────────────────────────────────────────────────
# JWT_AUTHORITY: where the service fetches OIDC metadata (internal URL in Docker).
# JWT_ISSUER / KEYCLOAK_EXTERNAL_*: used to validate the token issuer claim.
JWT_AUTHORITY=http://localhost:9090/realms/cv-realm
JWT_ISSUER=http://localhost:9090/realms/cv-realm
KEYCLOAK_EXTERNAL_HOST=localhost
KEYCLOAK_EXTERNAL_PORT=9090

# ── gRPC clients ──────────────────────────────────────────────────────────────
# Local dev: point to local gRPC ports. Docker: use service names.
USER_SERVICE_GRPC_URL=http://localhost:18082
