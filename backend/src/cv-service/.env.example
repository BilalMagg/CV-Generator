# ── cv-service environment variables ─────────────────────────────────────────
# Copy to .env and fill in secrets before running locally.
# Docker deployments override these via compose environment: blocks.

# ── Server ports ──────────────────────────────────────────────────────────────
PORT=5005
GRPC_PORT=18088

# ── Database ──────────────────────────────────────────────────────────────────
ConnectionStrings__DefaultConnection=Host=localhost;Port=5439;Database=cv_db;Username=postgres;Password=postgres

# ── Kafka ──────────────────────────────────────────────────────────────────────
# Local dev: use EXTERNAL listener (29092). Docker: kafka:9092
KAFKA_BOOTSTRAP_SERVERS=localhost:29092

# ── Keycloak / JWT ────────────────────────────────────────────────────────────
JWT_AUTHORITY=http://localhost:9090/realms/cv-realm
JWT_ISSUER=http://localhost:9090/realms/cv-realm
KEYCLOAK_EXTERNAL_HOST=localhost
KEYCLOAK_EXTERNAL_PORT=9090

# ── MinIO (object storage for generated CVs) ──────────────────────────────────
# Local dev: MinIO runs in Docker on port 9000.
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
