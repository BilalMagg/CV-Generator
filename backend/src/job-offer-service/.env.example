# ── job-offer-service environment variables ───────────────────────────────────
# Copy to .env and fill in secrets before running locally.
# Docker deployments override these via compose environment: blocks.

# ── Server port ───────────────────────────────────────────────────────────────
PORT=5007

# ── Database ──────────────────────────────────────────────────────────────────
ConnectionStrings__DefaultConnection=Host=localhost;Port=5437;Database=job_offer_db;Username=postgres;Password=postgres

# ── Kafka ──────────────────────────────────────────────────────────────────────
# Local dev: use EXTERNAL listener (29092). Docker: kafka:9092
# Config key: Kafka:BootstrapServers  →  env var: Kafka__BootstrapServers
Kafka__BootstrapServers=localhost:29092

# ── Keycloak / JWT ────────────────────────────────────────────────────────────
JWT_AUTHORITY=http://localhost:9090/realms/cv-realm
