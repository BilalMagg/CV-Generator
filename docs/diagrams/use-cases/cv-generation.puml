@startuml
left to right direction

actor "User" as user
actor "AI System" as ai

rectangle "CV Generation" {
    usecase "Generate CV" as GEN
    usecase "Select CV Template" as TPL
    usecase "Choose Tone" as TNE
    usecase "Export CV" as EXPORT
    usecase "View Generation History" as HIST
}

rectangle Login {
    usecase "Login" as LOG
}

user --> GEN
user --> TPL
user --> TNE
user --> EXPORT
user --> HIST

GEN --> LOG : <<include>>
TPL --> LOG : <<include>>
TNE --> LOG : <<include>>
EXPORT --> LOG : <<include>>
HIST --> LOG : <<include>>

ai <-- GEN

@enduml
