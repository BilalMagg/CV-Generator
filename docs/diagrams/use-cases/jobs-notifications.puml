@startuml
left to right direction

actor "User" as user

rectangle "Jobs & Notifications" {
    usecase "Browse Job Offers" as BRS
    usecase "Trigger Live Crawl" as CRAWL
    usecase "Configure Notifications" as NOTIF
    usecase "Set Reminders" as REM
    usecase "Schedule Email" as EMAIL
}

rectangle Login {
    usecase "Login" as LOG
}

user --> BRS
user --> CRAWL
user --> NOTIF
user --> REM
user --> EMAIL

BRS --> LOG : <<include>>
CRAWL --> LOG : <<include>>
NOTIF --> LOG : <<include>>
REM --> LOG : <<include>>
EMAIL --> LOG : <<include>>

@enduml
