@startuml
left to right direction

actor "User" as user

rectangle "Profile Management" {
    usecase "Manage Personal Profile" as PRF
    usecase "Manage Projects" as PRJ
    usecase "Manage Skills" as SKL
    usecase "Manage Experience" as EXP
    usecase "Manage Education" as EDU
    usecase "Manage Certifications" as CRT
    usecase "Manage Languages" as LNG
    usecase "Manage Social Links" as SOC
    usecase "Manage CV Profiles" as CVP
}

rectangle Login {
    usecase "Login" as LOG
}

user --> PRF
user --> PRJ
user --> SKL
user --> EXP
user --> EDU
user --> CRT
user --> LNG
user --> SOC
user --> CVP

PRF --> LOG : <<include>>
PRJ --> LOG : <<include>>
SKL --> LOG : <<include>>
EXP --> LOG : <<include>>
EDU --> LOG : <<include>>
CRT --> LOG : <<include>>
LNG --> LOG : <<include>>
SOC --> LOG : <<include>>
CVP --> LOG : <<include>>

@enduml
