@startuml
left to right direction

actor "User" as user

rectangle "Application Tracking" {
    usecase "Add Application" as ADD
    usecase "Update Status" as STS
    usecase "View Kanban Board" as KAN
    usecase "View Analytics" as ANL
    usecase "View Calendar" as CAL
}

rectangle Login {
    usecase "Login" as LOG
}

user --> ADD
user --> STS
user --> KAN
user --> ANL
user --> CAL

ADD --> LOG : <<include>>
STS --> LOG : <<include>>
KAN --> LOG : <<include>>
ANL --> LOG : <<include>>
CAL --> LOG : <<include>>

@enduml
