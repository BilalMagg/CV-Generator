// Propel — API Gateway Architecture
// Type: Cloud Architecture
// Flow: Browser → Nginx → API Gateway (YARP) → Microservices

Client Browser [icon: globe, color: blue] {
  HTTPS Requests
}

Nginx [icon: server, color: blue] {
  Reverse Proxy
  Static SPA Serving
  SSL Termination
}

API Gateway [icon: shield, color: yellow] {
  YARP .NET 10 :8080
  JWT Authentication
  Request Routing
  Rate Limiting
  Kafka Event Publishing
}

Service 1 [color: green] {
  User Service
  REST :8082 · gRPC :50001
  PostgreSQL user_db :5432
}

Service 2 [color: green] {
  CV Service
  REST :8088 · gRPC :50002
  PostgreSQL cv_db :5439
}

Service 3 [color: green] {
  Workflow Service
  REST :8084 · gRPC :50003
  PostgreSQL workflow_db :5435 (pgvector)
}

// External → Nginx
Client Browser > Nginx: HTTP :80 / HTTPS :443

// Nginx → Gateway
Nginx > API Gateway: /api/* → :8080

// Nginx → Frontend
Nginx > Client Browser: / → index.html (SPA)

// Gateway → Services
API Gateway > Service 1: /api/users/*
API Gateway > Service 2: /api/cv/*
API Gateway > Service 3: /api/workflows/*

// Services → Databases
Service 1 > PostgreSQL: user_db
Service 2 > PostgreSQL: cv_db
Service 3 > PostgreSQL: workflow_db
