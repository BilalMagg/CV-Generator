// Propel — Database Entity Relationship Diagrams
// Type: Entity Relationship
// 8 databases across all microservices

// ═══════════════════════════════════════════════
// 1. User Database (user_db :5433)
// ═══════════════════════════════════════════════

users [icon: user, color: blue] {
  id string pk
  keycloakId string unique
  firstName string
  lastName string
  email string unique
  role string
  phoneNumber string
  birthDate timestamp
  avatarUrl string
  headline string
  bio text
  city string
  country string
  authorizedCountry string
  requiresVisaSponsorship boolean
  noticePeriod string
  employmentTypes text
  remotePreference string
  willingToRelocate string
  desiredJobTitle string
  desiredSalaryMin decimal
  desiredSalaryMax decimal
  professionalTitles text
  preferencesJson text
  aiProfileDataJson text
  isActive boolean
  createdAt timestamp
  lastLogin timestamp
}

// ═══════════════════════════════════════════════
// 2. Content Database (content_db :5434)
// ═══════════════════════════════════════════════

projects [icon: folder, color: green] {
