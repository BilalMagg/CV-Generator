  category string
  level string
  yearsOfExperience int
}

experiences [icon: briefcase, color: green] {
  id string pk
  userId string fk
  title string
  company string
  description string
  startDate timestamp
  endDate timestamp
  status string
}

educations [icon: book, color: green] {
  id string pk
  userId string fk
  institutionName string
  degreeType string
  fieldOfStudy string
  specialization string
  city string
  startDate timestamp
  endDate timestamp
  status string
  diplomaFileUrl string
}

certifications [icon: award, color: green] {
  id string pk
  userId string fk
  name string
  issuingOrganization string
  issueDate timestamp
  credentialUrl string
}

languages [icon: globe, color: green] {
  id string pk
  userId string fk
  name string
  level string
}

interests [icon: heart, color: green] {
  id string pk
  userId string fk
  name string
}

hackathons [icon: zap, color: green] {
  id string pk
  userId string fk
  name string
  organization text
  date timestamp
  role text
  result text
  description text
}

socialLinks [icon: link, color: green] {
  id string pk
  userId string fk
  platform string
  url string
}

cvProfiles [icon: file, color: green] {
  id string pk
  userId string fk
  title string
  summary text
}

academicActivities [icon: book-open, color: green] {
  id string pk
  userId string fk
  title string
  organization text
  description text
  startDate timestamp
  endDate timestamp
}

// Content → User relationships
projects.userId > users.id
skills.userId > users.id
experiences.userId > users.id
educations.userId > users.id
certifications.userId > users.id
languages.userId > users.id
interests.userId > users.id
hackathons.userId > users.id
socialLinks.userId > users.id
cvProfiles.userId > users.id
academicActivities.userId > users.id

// ═══════════════════════════════════════════════
// 3. Application Database (application_db :5436)
// ═══════════════════════════════════════════════

applications [icon: clipboard, color: yellow] {
  id string pk
  candidateId string fk
  cvVersionId string fk
  jobOfferId string fk
  companyName string
  positionTitle string
  offerSource string
  status string
  appliedAt timestamp
  updatedAt timestamp
  notes text
  isSaved boolean
}

applicationStatusHistory [icon: clock, color: yellow] {
  id string pk
  applicationId string fk
  oldStatus string
  newStatus string
  changedAt timestamp
  changedBy string
  comment text
}

applicationConfigurations [icon: settings, color: yellow] {
  id string pk
  userId string unique
  showReminders boolean
  selectedStatuses string
}

applications.candidateId > users.id
applications.cvVersionId > cvVersions.id
applicationStatusHistory.applicationId > applications.id

