// Propel — System Architecture
// Type: Cloud Architecture
// High-level overview of all services, databases, and infrastructure

Browser [icon: globe, color: blue]
Nginx [icon: server, color: blue]

API Gateway [icon: shield, color: yellow] {
  YARP Reverse Proxy :8080
  Routes: /api/* to backend services
}

User Service [icon: users, color: green] {
  REST :8082 · gRPC :50001
  User CRUD · Keycloak Sync
}

User Content Service [icon: file-text, color: green] {
  REST :8083
  Portfolio: Projects, Skills, Experience, etc.
}

Workflow Service [icon: git-branch, color: green] {
  REST :8084
  CV Generation Orchestration
}

Application Service [icon: clipboard, color: green] {
  REST :8085
  Job Application Tracking
}

Job Offer Service [icon: briefcase, color: green] {
  REST :8086 · SignalR Hub
  Job Offers · Live Crawling
}

Notification Service [icon: bell, color: green] {
  REST :8087
  Email · Reminders · Hangfire
}

CV Service [icon: file, color: green] {
  REST :8088
  CV Creation · Export PDF/DOCX
}

AI Agents [color: purple] {
  Job Extractor [icon: search, color: purple]
  Search Agent [icon: database, color: purple]
  Template Agent [icon: layout, color: purple]
  CV Optimizer [icon: check-circle, color: purple]
  Contact Agent [icon: mail, color: purple]
  Job Crawler [icon: globe, color: purple]
}

Infrastructure [color: orange] {
  Keycloak [icon: lock, color: orange]
  Kafka [icon: message-circle, color: orange]
  MinIO [icon: hard-drive, color: orange]
  PostgreSQL [icon: database, color: orange]
}

// Frontend → Gateway
Browser > Nginx
Nginx > API Gateway: /api/* :8080

// Gateway → Services
API Gateway > User Service: /api/users/*
API Gateway > User Content Service: /api/user-content/*
API Gateway > Workflow Service: /api/workflows/*
API Gateway > Application Service: /api/applications/*
API Gateway > Job Offer Service: /api/job-offers/*
API Gateway > Notification Service: /api/notifications/*
API Gateway > CV Service: /api/cv/*

// Inter-service
User Service < Application Service: gRPC

// Workflow → AI Agents
Workflow Service > Job Extractor
Workflow Service > Search Agent
Workflow Service > Template Agent
Workflow Service > CV Optimizer
Workflow Service > Contact Agent

// Events
API Gateway > Kafka: user.registered
Job Offer Service > Kafka: trigger-live-crawl
Kafka > Notification Service: user.registered
Kafka > Job Crawler: trigger-live-crawl

// Databases
User Service > PostgreSQL: user_db :5433
User Content Service > PostgreSQL: content_db :5434
Workflow Service > PostgreSQL: workflow_db :5435
Application Service > PostgreSQL: application_db :5436
Job Offer Service > PostgreSQL: job_offer_db :5437
Notification Service > PostgreSQL: notification_db :5438
CV Service > PostgreSQL: cv_db :5439

// Storage & Auth
CV Service > MinIO: store CV PDFs
API Gateway > Keycloak: OIDC auth
API Gateway > User Service: sync user