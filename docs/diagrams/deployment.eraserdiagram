// Propel — Local Deployment Architecture
// Type: Cloud Architecture
// 8 VMs across 5 team members — each service has its DB on the same VM

Bilal [color: blue] {
  VM1 - Frontend + Gateway [icon: server, color: blue] {
    Nginx [icon: server, color: blue] {
      Angular SPA · proxies /api/*
    }
    API Gateway [icon: shield, color: yellow] {
      YARP Reverse Proxy :8080
      Keycloak Auth · Kafka Publisher
    }
  }

  VM2 - User Content Application [icon: server, color: blue] {
    User Service [icon: users, color: green] {
      REST :8082 · gRPC :50001
    }
    user_db [icon: database, color: green] { :5433 }

    User Content Service [icon: file-text, color: green] {
      REST :8083
    }
    content_db [icon: database, color: green] { :5434 }

    Application Service [icon: clipboard, color: green] {
      REST :8085
    }
    application_db [icon: database, color: green] { :5436 }

    Notification Service [icon: bell, color: green] {
      REST :8087
      Email · Reminders · Hangfire
    }
    notification_db [icon: database, color: green] { :5438 }
  }

  VM3 - Extractor Contact Template [icon: server, color: blue] {
    Job Extractor [icon: search, color: purple] {
      Extract requirements :8001
    }
    Contact Agent [icon: mail, color: purple] {
      Email delivery :8005
    }
    Template Agent [icon: layout, color: purple] {
      Render CV templates :8003
    }
  }
}

Somia [color: green] {
  VM1 - Content Workflow [icon: server, color: green] {
    Workflow Service [icon: git-branch, color: green] {
      CV Generation Orchestration :8084
    }
    workflow_db [icon: database, color: green] { :5435 · pgvector }
  }

  VM2 - Optimizer Search Crawler [icon: server, color: green] {
    CV Optimizer [icon: check-circle, color: purple] {
      ATS compliance :8004
    }
    Search Agent [icon: database, color: purple] {
      RAG profile matching :8002
    }
    Job Crawler [icon: globe, color: purple] {
      Job board crawling :8006
    }
  }
}

Nourelhouda [color: orange] {
  VM1 - Tools [icon: server, color: orange] {
    Keycloak [icon: lock, color: red] {
      OIDC Provider :9090
      Realm: cv-realm
    }
    keycloak_db [icon: database, color: red] { :5440 }

    Kafka [icon: message-circle, color: orange] {
      Event Bus :9092 · KRaft mode
    }

    MinIO [icon: hard-drive, color: orange] {
      S3 Storage :9000/:9001
      CV PDF artifacts
    }
  }
}

Mouhssine [color: red] {
  VM1 - CV Job Offer [icon: server, color: red] {
    CV Service [icon: file, color: green] {
      CV Creation · Versioning · Export :8088
    }
    cv_db [icon: database, color: red] { :5439 }

    Job Offer Service [icon: briefcase, color: green] {
      Job Offers · SignalR Hub :8086
    }
    job_offer_db [icon: database, color: red] { :5437 }
  }
}

Salman [color: purple] {
  VM1 - Monitoring [icon: server, color: purple] {
    Prometheus [icon: bar-chart, color: green] {
      Metrics collection
    }
    Grafana [icon: bar-chart, color: green] {
      Dashboards & visualization
    }
  }
}

// Bilal VM1 → VM2
API Gateway > User Service: /api/users/*
API Gateway > User Content Service: /api/user-content/*
API Gateway > Application Service: /api/applications/*

// Bilal VM1 → Somia VM1
API Gateway > Workflow Service: /api/workflows/*

// Bilal VM1 → Mouhssine
API Gateway > CV Service: /api/cv/*
API Gateway > Job Offer Service: /api/job-offers/*

// Bilal VM1 → Nourelhouda
API Gateway > Keycloak: OIDC auth
API Gateway > Kafka: user.registered event

// Bilal VM1 → Salman
Prometheus > API Gateway: scrape metrics

// Somia VM1 → Bilal VM3
Workflow Service > Job Extractor: HTTP
Workflow Service > Contact Agent: HTTP
Workflow Service > Template Agent: HTTP

// Somia VM1 → Somia VM2
Workflow Service > CV Optimizer: ATS optimization
Workflow Service > Search Agent: portfolio search

// Somia VM1 → Nourelhouda
Job Offer Service > Kafka: trigger-live-crawl
Kafka > Job Crawler: trigger-live-crawl

// Mouhssine → Nourelhouda
CV Service > MinIO: store PDFs

// Salman → rest
Prometheus > Workflow Service: scrape metrics
Prometheus > CV Service: scrape metrics