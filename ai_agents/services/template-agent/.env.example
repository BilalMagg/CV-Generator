# Template Agent
SERVICE_NAME=template-agent
TEMPLATE_AGENT_URL=http://localhost:8003
BACKEND_BASE_URL=http://cv-api-gateway:8080
GROQ_API_KEY=change-me

# MinIO object storage (required — service fails at startup if unset).
# Local dev points at the MinIO container; in the cloud set these to the
# deployed MinIO/S3 endpoint and rotate the credentials via your secrets store.
MINIO_ENDPOINT=cv-minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_SECURE=false
MINIO_BUCKET=cv-pdfs
MINIO_TEMPLATES_BUCKET=cv-templates
