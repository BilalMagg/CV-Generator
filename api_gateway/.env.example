# ── api-gateway environment variables ────────────────────────────────────────
# Copy to .env and fill in secrets before running locally.
# Docker deployments override these via compose environment: blocks.

# ── Gateway ───────────────────────────────────────────────────────────────────
GATEWAY_HOST=localhost
GATEWAY_PORT=8080

# ── Frontend ──────────────────────────────────────────────────────────────────
FRONTEND_HOST=localhost
FRONTEND_PORT=4200

# ── Keycloak (internal URL used for token exchange; external for browser redirects) ──
KEYCLOAK_HOST=localhost
KEYCLOAK_PORT=9090
KEYCLOAK_EXTERNAL_HOST=localhost
KEYCLOAK_EXTERNAL_PORT=9090
KEYCLOAK_REALM=cv-realm
KEYCLOAK_CLIENT_ID=cv-gateway
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# ── Kafka ──────────────────────────────────────────────────────────────────────
# Local dev: use EXTERNAL listener (29092). Docker: kafka / 9092
KAFKA_HOST=localhost
KAFKA_PORT=29092

# ── Downstream service addresses (YARP reverse proxy targets) ─────────────────
# Local dev: services run with dotnet run on these ports.
# Docker: use service names (cv-user-service, etc.) and internal ports.
USER_SERVICE_HOST=localhost
USER_SERVICE_PORT=5001

CONTENT_SERVICE_HOST=localhost
CONTENT_SERVICE_PORT=5002

WORKFLOW_SERVICE_HOST=localhost
WORKFLOW_SERVICE_PORT=5003

APPLICATION_SERVICE_HOST=localhost
APPLICATION_SERVICE_PORT=5004

JOB_OFFER_SERVICE_HOST=localhost
JOB_OFFER_SERVICE_PORT=5007

NOTIFICATION_SERVICE_HOST=localhost
NOTIFICATION_SERVICE_PORT=5006

CV_SERVICE_HOST=localhost
CV_SERVICE_PORT=5005

# ── OAuth identity providers (optional — leave blank to disable social login) ─
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
