{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Debug"
    }
  },
  "AllowedHosts": "*",
  "Proxy": {
    "Routes": {
      "user-route": {
        "ClusterId": "user-cluster",
        "Match": { "Path": "/api/users/{**catch-all}" }
      },
      "user-content-route": {
        "ClusterId": "content-cluster",
        "Match": { "Path": "/api/user-content/{**remainder}" },
        "Transforms": [
          { "PathPattern": "/api/{**remainder}" }
        ]
      },
      "workflow-route": {
        "ClusterId": "workflow-cluster",
        "Match": { "Path": "/api/workflows/{**catch-all}" }
      },
      "application-route": {
        "ClusterId": "application-cluster",
        "Match": { "Path": "/api/applications/{**catch-all}" }
      },
      "job-offer-route": {
        "ClusterId": "job-offer-cluster",
        "Match": { "Path": "/api/job-offers/{**catch-all}" }
      },
      "reminder-route": {
        "ClusterId": "notification-cluster",
        "Match": { "Path": "/api/reminders/{**catch-all}" }
      },
      "notification-route": {
        "ClusterId": "notification-cluster",
        "Match": { "Path": "/api/notifications/{**catch-all}" }
      },
      "cv-route": {
        "ClusterId": "cv-cluster",
        "Match": { "Path": "/api/cv/{**catch-all}" }
      },
      "agents-route": {
        "ClusterId": "workflow-cluster",
        "Match": { "Path": "/api/agents/{**catch-all}" }
      },
      "gmail-route": {
        "ClusterId": "notification-cluster",
        "Match": { "Path": "/api/gmail/{**catch-all}" }
      },
      "contacts-route": {
        "ClusterId": "notification-cluster",
        "Match": { "Path": "/api/contacts/{**catch-all}" }
      },
      "email-schedules-route": {
        "ClusterId": "notification-cluster",
        "Match": { "Path": "/api/email-schedules/{**catch-all}" }
      },
      "mailbox-route": {
        "ClusterId": "notification-cluster",
        "Match": { "Path": "/api/mailbox/{**catch-all}" }
      }
    },
    "Clusters": {
      "user-cluster": {
        "Destinations": {
          "destination-1": { "Address": "http://cv-user-service:8082" }
        }
      },
      "content-cluster": {
        "Destinations": {
          "destination-1": { "Address": "http://cv-user-content-service:8083" }
        }
      },
      "workflow-cluster": {
        "Destinations": {
          "destination-1": { "Address": "http://cv-workflow-service:8084" }
        }
      },
      "application-cluster": {
        "Destinations": {
          "destination-1": { "Address": "http://cv-application-service:8085" }
        }
      },
      "job-offer-cluster": {
        "Destinations": {
          "destination-1": { "Address": "http://cv-job-offer-service:8086" }
        }
      },
      "notification-cluster": {
        "Destinations": {
          "destination-1": { "Address": "http://cv-notification-service:8087" }
        }
      },
      "cv-cluster": {
        "Destinations": {
          "destination-1": { "Address": "http://cv-cv-service:8088" }
        }
      }
    }
  }
}
